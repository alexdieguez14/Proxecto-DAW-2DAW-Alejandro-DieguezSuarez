{% extends 'base.html.twig' %}

{% block title %}{{ 'cliente.title'|trans }}{% endblock %}

{% block body_attrs %}
    data-url-acceso="{{ path('app_acceso') }}"
    data-url-pedido="{{ path('app_tienda_pedido_crear') }}"
    data-url-datos-checkout="{{ path('app_tienda_checkout_data') }}"
    data-url-guardar-direccion="{{ path('app_tienda_save_address') }}"
    data-url-guardar-metodo-pago="{{ path('app_tienda_save_payment_method') }}"
    data-token-csrf="{{ csrf_token('place_order') }}"
    data-token-csrf-checkout="{{ csrf_token('checkout') }}"
    data-autenticado="{{ app.user ? 'true' : 'false' }}"
    data-i18n-loading="{{ 'common.loading'|trans }}"
    data-i18n-required="{{ 'common.required'|trans|default('Obligatorio') }}"
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/cliente.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    window.i18n = {
        'cart.empty':            {{ 'cart.empty'|trans|json_encode|raw }},
        'js.error.loading_data': {{ 'js.error.loading_data'|trans|json_encode|raw }},
        'js.error.select_shipping': {{ 'js.error.select_shipping'|trans|json_encode|raw }},
        'js.error.select_billing':  {{ 'js.error.select_billing'|trans|json_encode|raw }},
        'js.error.select_payment':  {{ 'js.error.select_payment'|trans|json_encode|raw }},
        'js.error.fill_card':       {{ 'js.error.fill_card'|trans|json_encode|raw }},
        'js.error.invalid_card_number': {{ 'js.error.invalid_card_number'|trans|json_encode|raw }},
        'js.error.enter_iban':      {{ 'js.error.enter_iban'|trans|json_encode|raw }},
        'js.error.order_failed':    {{ 'js.error.order_failed'|trans|json_encode|raw }},
        'js.error.connection':      {{ 'js.error.connection'|trans|json_encode|raw }},
        'js.success.order_placed':  {{ 'js.success.order_placed'|trans|json_encode|raw }},
        'js.cart.unit':             {{ 'js.cart.unit'|trans|json_encode|raw }},
        'js.address.new':           {{ 'js.address.new'|trans|json_encode|raw }},
        'js.method.new':            {{ 'js.method.new'|trans|json_encode|raw }},
        'checkout.confirm_order':   {{ 'checkout.confirm_order'|trans|json_encode|raw }}
    };
    window.t = function (key) { return window.i18n[key] || key; };
    </script>
    <script src="{{ asset('js/tienda-carrito.js') }}" defer></script>
{% endblock %}

{% from 'components/_filter_bar.html.twig' import filter_bar %}

{% block body %}
    <header>
        <nav class="navbar">
            <a class="nav-logo" href="#inicio">
                <img src="{{ asset('images/logo-transparent.png') }}" alt="O Porto do Sabor">
            </a>

            <button class="nav-hamburger js-nav-toggle" aria-label="{{ 'nav.open_menu'|trans }}" aria-expanded="false">
                <span class="material-icons">menu</span>
            </button>

            <div class="contenedor-menu js-nav-menu">
                <div class="menu-overlay-header">
                    <a class="nav-logo" href="#inicio">
                        <img src="{{ asset('images/logo-transparent.png') }}" alt="O Porto do Sabor">
                    </a>
                    <button class="nav-hamburger js-nav-toggle" aria-label="{{ 'nav.close_menu'|trans }}" aria-expanded="false">
                        <span class="material-icons">close</span>
                    </button>
                </div>

                <ul class="categorias-centro">
                    {% for cat in categories %}
                        <li><a href="#{{ cat.slug }}">{{ cat.title }}</a></li>
                    {% endfor %}
                </ul>

                <ul class="usuario-derecha">
                    {% include 'partials/_nav-cuenta.html.twig' with { nav_context: 'tienda' } %}
                    <li>
                        <button class="enlace-cesta" type="button" data-abrir-cesta>
                            <span class="material-icons" aria-hidden="true">shopping_cart</span>
                            {{ 'nav.cart'|trans }}
                            <span class="contador-cesta" data-contador-cesta>0</span>
                        </button>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <main id="contenido-principal">
        <section class="sobre-nosotros" id="inicio">
            <header class="texto-hero">
                <h1>{{ 'cliente.hero.title'|trans }}</h1>
                <p>{{ 'cliente.hero.subtitle'|trans }}</p>
                <a class="accion-hero" href="#{{ categories|first.slug|default('tienda') }}">{{ 'cliente.hero.cta'|trans }}</a>
            </header>
        </section>

        <section class="seccion-tienda" id="buscar" style="padding-top:1.5rem;">
            {{ filter_bar(filtroForm) }}
        </section>

        {% if categories is empty %}
            <section class="seccion-tienda" style="padding:2rem 1.5rem;">
                <p>{{ 'cliente.no_products'|trans }}</p>
            </section>
        {% endif %}

        {% for cat in categories %}
            <section class="seccion-tienda {{ loop.index is even ? 'seccion-alterna' : '' }}" id="{{ cat.slug }}">
                <header class="seccion-encabezado">
                    <h2>{{ cat.title }}</h2>
                </header>
                <div class="cuadricula-productos">
                    {% for articulo in cat.products %}
                        {% set _titulo = articulo.tituloLocalizado(app.request.locale) %}
                        {% set _descripcion = articulo.descripcionLocalizada(app.request.locale) %}
                        <article class="tarjeta-producto">
                            <figure class="imagen-tarjeta-producto"
                                 style="background-image: url('{{ articulo.imagen ? asset('images/' ~ articulo.imagen) : asset('images/default.jpg') }}');"
                                 role="img" aria-label="{{ _titulo }}"></figure>
                            <div class="info-tarjeta-producto">
                                <p class="categoria-etiqueta">{{ cat.title }}</p>
                                <h3>{{ _titulo }}</h3>
                                <p class="descripcion-producto">{{ _descripcion }}</p>
                                <footer class="compra-tarjeta-producto">
                                    <span class="precio">{{ articulo.precio|number_format(2, ',', '.') }} €</span>
                                    <button type="button"
                                            data-agregar-cesta
                                            data-id="{{ articulo.id }}"
                                            data-titulo="{{ _titulo }}"
                                            data-precio="{{ articulo.precio }}"
                                            data-imagen="{{ articulo.imagen ?? '' }}"
                                            data-categoria="{{ cat.title }}"
                                            data-stock="{{ articulo.stock }}">
                                        {{ 'cliente.add'|trans }}
                                    </button>
                                </footer>
                            </div>
                        </article>
                    {% else %}
                        <p class="aviso-vacio">{{ 'cliente.category_empty'|trans({ '%category%': cat.title }) }}</p>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    </main>

    {# ── Panel lateral de la cesta ── #}
    <aside class="panel-cesta" data-panel-cesta aria-hidden="true" role="dialog" aria-label="{{ 'cart.heading'|trans }}">
        <header class="cabecera-cesta">
            <div>
                <p>{{ 'cart.subheading'|trans }}</p>
                <h2>{{ 'cart.heading'|trans }}</h2>
            </div>
            <button class="cerrar-cesta" type="button" data-cerrar-cesta aria-label="{{ 'cart.close'|trans }}">
                <span class="material-icons">close</span>
            </button>
        </header>
        <div class="articulos-cesta" data-articulos-cesta aria-live="polite">
            <p class="cesta-vacia">{{ 'cart.empty'|trans }}</p>
        </div>
        <footer class="resumen-cesta">
            <p class="fila-total">
                <span>{{ 'cart.estimated_total'|trans }}</span>
                <strong data-total-cesta>0,00 €</strong>
            </p>
            <button class="boton-finalizar" type="button" data-finalizar-compra>{{ 'cart.checkout'|trans }}</button>
            <button class="vaciar-cesta" type="button" data-vaciar-cesta>{{ 'cart.empty_action'|trans }}</button>
        </footer>
    </aside>

    <span class="capa-superpuesta" data-fondo-cesta></span>

    {# ── Asistente de compra ── #}
    <div class="asistente-compra" id="asistente-compra" role="dialog" aria-modal="true" aria-label="{{ 'checkout.title'|trans }}">
        <article class="interior-asistente">

            {# Barra de progreso #}
            <nav class="barra-progreso" aria-label="{{ 'checkout.steps'|trans }}">
                <article class="indicador-paso active" data-paso="1">
                    <span class="numero-paso">1</span>
                    <span class="etiqueta-paso">{{ 'checkout.step.address'|trans }}</span>
                </article>
                <hr class="separador-paso">
                <article class="indicador-paso" data-paso="2">
                    <span class="numero-paso">2</span>
                    <span class="etiqueta-paso">{{ 'checkout.step.payment'|trans }}</span>
                </article>
            </nav>

            {# Paso 1: Dirección #}
            <div class="panel-paso" id="paso-1">
                <h3 class="titulo-seccion">
                    <span class="material-icons">local_shipping</span>
                    {{ 'checkout.shipping_address'|trans }}
                </h3>
                <div id="contenido-envio" class="opciones-direccion"></div>

                <label class="etiqueta-misma-direccion">
                    <input type="checkbox" id="misma-direccion" checked>
                    {{ 'checkout.same_address'|trans }}
                </label>

                <div id="seccion-facturacion" hidden>
                    <h3 class="titulo-seccion" style="margin-top:1.5rem;">
                        <span class="material-icons">receipt</span>
                        {{ 'checkout.billing_address'|trans }}
                    </h3>
                    <div id="contenido-facturacion" class="opciones-direccion"></div>
                </div>
            </div>

            {# Paso 2: Pago #}
            <div class="panel-paso" id="paso-2" hidden>
                <h3 class="titulo-seccion">
                    <span class="material-icons">payments</span>
                    {{ 'payment.method'|trans }}
                </h3>

                <div class="metodo-pago-options" id="metodo-pago-options">
                    <label class="opcion-pago">
                        <input type="radio" name="metodo_pago" value="TARJETA">
                        <div class="tarjeta-opcion">
                            <span class="material-icons">credit_card</span>
                            <p>
                                <strong>{{ 'payment.tarjeta'|trans }}</strong>
                                <span>{{ 'payment.tarjeta.desc'|trans }}</span>
                            </p>
                        </div>
                    </label>
                    <label class="opcion-pago">
                        <input type="radio" name="metodo_pago" value="TRANSFERENCIA">
                        <div class="tarjeta-opcion">
                            <span class="material-icons">account_balance</span>
                            <p>
                                <strong>{{ 'payment.transferencia'|trans }}</strong>
                                <span>{{ 'payment.transferencia.desc'|trans }}</span>
                            </p>
                        </div>
                    </label>
                    <label class="opcion-pago">
                        <input type="radio" name="metodo_pago" value="CONTRARREEMBOLSO">
                        <div class="tarjeta-opcion">
                            <span class="material-icons">local_shipping</span>
                            <p>
                                <strong>{{ 'payment.contrarreembolso'|trans }}</strong>
                                <span>{{ 'payment.contrarreembolso.desc'|trans }}</span>
                            </p>
                        </div>
                    </label>
                </div>

                {# Detalles TARJETA #}
                <div id="seccion-tarjeta" hidden>
                    <div id="tarjetas-guardadas" class="metodos-guardados"></div>
                    <div id="formulario-tarjeta" class="formulario-nuevo-metodo" hidden>
                        <p class="grupo-campo">
                            <label>{{ 'checkout.cardholder'|trans }}</label>
                            <input type="text" id="titular" placeholder="{{ 'checkout.cardholder_placeholder'|trans }}" autocomplete="cc-name">
                        </p>
                        <p class="grupo-campo">
                            <label>{{ 'checkout.card_number'|trans }}</label>
                            <input type="text" id="numero-tarjeta" placeholder="**** **** **** ****"
                                   maxlength="19" autocomplete="cc-number" inputmode="numeric">
                        </p>
                        <div class="fila-dos">
                            <p class="grupo-campo">
                                <label>{{ 'checkout.card_expiry'|trans }}</label>
                                <input type="text" id="vencimiento" placeholder="MM/AA"
                                       maxlength="5" autocomplete="cc-exp" inputmode="numeric">
                            </p>
                            <p class="grupo-campo">
                                <label>{{ 'checkout.card_cvv'|trans }}</label>
                                <input type="password" id="cvv" placeholder="···"
                                       maxlength="4" autocomplete="off" inputmode="numeric">
                            </p>
                        </div>
                        <label class="etiqueta-guardar">
                            <input type="checkbox" id="guardar-tarjeta" checked>
                            {{ 'checkout.save_card'|trans }}
                        </label>
                    </div>
                    <button type="button" class="boton-agregar-metodo" id="boton-nueva-tarjeta">
                        <span class="material-icons">add</span> {{ 'checkout.add_card'|trans }}
                    </button>
                </div>

                {# Detalles TRANSFERENCIA #}
                <div id="seccion-transferencia" hidden>
                    <div id="cuentas-guardadas" class="metodos-guardados"></div>
                    <div id="formulario-iban" class="formulario-nuevo-metodo" hidden>
                        <p class="grupo-campo">
                            <label>{{ 'checkout.iban'|trans }}</label>
                            <input type="text" id="numero-iban" placeholder="ES91 2100 0418 4502 0005 1332"
                                   autocomplete="off" style="text-transform:uppercase">
                        </p>
                        <p class="grupo-campo">
                            <label>{{ 'checkout.iban_alias'|trans }}</label>
                            <input type="text" id="alias-iban" placeholder="{{ 'checkout.iban_alias_placeholder'|trans }}">
                        </p>
                        <label class="etiqueta-guardar">
                            <input type="checkbox" id="guardar-cuenta" checked>
                            {{ 'checkout.save_account'|trans }}
                        </label>
                    </div>
                    <button type="button" class="boton-agregar-metodo" id="boton-nueva-cuenta">
                        <span class="material-icons">add</span> {{ 'checkout.add_account'|trans }}
                    </button>
                </div>

                {# Información CONTRARREEMBOLSO #}
                <div id="seccion-contrarreembolso" hidden>
                    <aside class="contrarreembolso-info">
                        <span class="material-icons">info</span>
                        <p>{{ 'payment.contrarreembolso.info'|trans }}</p>
                    </aside>
                </div>
            </div>

            {# Botones de acción #}
            <footer class="acciones-asistente">
                <button type="button" class="boton-cancelar" id="boton-cancelar">{{ 'common.cancel'|trans }}</button>
                <nav class="nav-asistente">
                    <button type="button" class="boton-atras" id="boton-atras" hidden>
                        <span class="material-icons">arrow_back</span> {{ 'common.back'|trans }}
                    </button>
                    <button type="button" class="boton-siguiente" id="boton-siguiente">
                        {{ 'common.next'|trans }} <span class="material-icons">arrow_forward</span>
                    </button>
                    <button type="button" class="boton-confirmar" id="boton-confirmar" hidden>
                        <span class="material-icons">check</span> {{ 'checkout.confirm_order'|trans }}
                    </button>
                </nav>
            </footer>

        </article>
    </div>
    <span class="fondo-asistente" id="fondo-asistente"></span>

    <footer>
        <p>&copy; {{ "now"|date("Y") }} {{ 'cliente.footer'|trans }}</p>
    </footer>

    <aside class="flash-contenedor" id="flash-contenedor" aria-label="{{ 'checkout.notifications'|trans }}"></aside>

    <aside class="aviso-cookies" id="aviso-cookies" role="region" aria-label="{{ 'cookies.text'|trans|slice(0, 40) }}">
        <p class="aviso-cookies__texto">
            {{ 'cookies.text'|trans }}
            <a class="aviso-cookies__enlace" href="#">{{ 'cookies.more_info'|trans }}</a>
        </p>
        <footer class="aviso-cookies__acciones">
            <button class="aviso-cookies__boton aviso-cookies__boton--secundario" id="cookies-rechazar" type="button">
                {{ 'cookies.necessary_only'|trans }}
            </button>
            <button class="aviso-cookies__boton aviso-cookies__boton--primario" id="cookies-aceptar" type="button">
                {{ 'cookies.accept_all'|trans }}
            </button>
        </footer>
    </aside>
{% endblock %}
