{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.login.title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
{% endblock %}

{% block body %}
    {# h1 oculto visualmente pero accesible para lectores de pantalla #}
    <h1>{{ 'auth.login.title'|trans }}</h1>

    <main>
        <div class="portada">
            <figure>
                <img src="{{ asset('images/bateas.webp') }}" alt="">
            </figure>
        </div>

        <section>
            <figure>
                <img src="{{ asset('images/logo-transparent.png') }}" alt="O Porto do Sabor">
            </figure>

            <header style="display:flex;justify-content:flex-end;width:100%;">
                {% include 'components/_locale_switcher.html.twig' %}
            </header>

            <h2>{{ 'auth.login.title'|trans }}</h2>
            <h3>{{ 'auth.login.subtitle'|trans }}</h3>

            {% if error %}
                <p class="alert-error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
            {% endif %}

            {{ form_start(form) }}
                <p>
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </p>
                <p>
                    {{ form_label(form.password) }}
                    {{ form_widget(form.password) }}
                    {{ form_errors(form.password) }}
                </p>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn">{{ 'auth.login.submit'|trans }}</button>
            {{ form_end(form, {render_rest: false}) }}

            <p class="link-registro">{{ 'auth.login.no_account'|trans }} <a href="{{ path('app_registro') }}">{{ 'auth.login.register_link'|trans }}</a></p>
        </section>
    </main>
{% endblock %}
