<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contabilidad</title>

    <link rel="stylesheet" href="{{ asset('css/contabilidad.css') }}">
</head>

<body>

<header>
    <nav>
        <ul>

     
            <li class="logo">
                <a href="{{ path('app_admin') }}">
                    <img src="{{ asset('images/logo-transparent.png') }}" alt="Logo empresa">
                </a>
            </li>

            
            <li><a href="">Contabilidad</a></li>
            <li><a href="">Empleados</a></li>
            <li><a href="">Proveedores</a></li>

            {% if app.user %}
                <li class="user">👤 {{ app.user.email }}</li>
                <li><a href="{{ path('app_logout') }}">Cerrar sesión</a></li>
            {% else %}
                <li><a href="{{ path('app_login') }}">Iniciar sesión</a></li>
            {% endif %}

        </ul>
    </nav>
</header>

<main>

    <div class="contabilidad">
        <h1>Panel de Contabilidad</h1>
        <p>Gestión financiera, empleados y proveedores</p>
    </div>

</main>

</body>
</html>